{
	"compilerOptions": {
		"target": "ESNext",
		"module": "NodeNext",
		"moduleResolution": "nodenext",
		"strict": true,
		"skipLibCheck": true,
		"types": ["node"],
		"jsx": "react-jsx",
		"jsxImportSource": "hono/jsx",
		"allowJs": true,
		"outDir": "./dist",
		"paths": {
			"@/*": ["./src/*"]
		},
		"noImplicitReturns": true,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"plugins": [
			{
				"transform": "typescript-transform-paths"
			}
		]
	},
	"include": ["./src/**/*"],
	"exclude": ["node_modules", "dist"]
}
